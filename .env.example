# =================================================================
# MEXC ↔ Telegram Trading Bridge Environment Configuration Template
# =================================================================

# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Whitelisted Telegram User IDs (Comma-separated integers)
# Send /start to @userinfobot to find your Telegram User ID
TELEGRAM_WHITELISTED_USERS="7041560211"

# Master Encryption Key (Fernet 32-byte urlsafe base64 string)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=""

# MEXC Futures API Credentials
# (Can be stored encrypted or plaintext; encrypted recommended)
MEXC_API_KEY=""
MEXC_SECRET_KEY=""

# Database Path
DB_PATH="data/mexc_bridge.db"

# Risk Management Controls
RISK_MAX_LEVERAGE="50"
RISK_MAX_POSITION_EQUITY_PCT="50.0"
RISK_DAILY_LOSS_LIMIT_USDT="500.0"
RISK_MAX_DAILY_LOSS_PCT="15.0"

# Simulation / Dry Run Mode (true: paper trade, false: real execution)
DRY_RUN="false"

# Security & PIN Protection
REQUIRE_PIN="false"
PIN_SESSION_TIMEOUT_MINUTES="30"

# Automated Positions Broadcast Schedule
AUTO_POSITIONS_ENABLED="true"
AUTO_POSITIONS_INTERVAL_MINUTES="60"

# Optional Fallback Webhook URL
FALLBACK_WEBHOOK_URL=""
